# Copy this file to .env.local and fill in values from the Supabase project.
# .env.local never goes to GitHub.

# Project URL + "anon" key: public, used from the browser. Not a password.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site URL (no trailing slash). Used in the Telegram button that opens /k/{token}.
# Local: http://localhost:3000   Production: https://your-domain.vercel.app
# Na Vercelu: mora pun https:// URL, jedan red, tip "Config" (ne "Secret" —
# NEXT_PUBLIC_ se inline-uje pri build-u); posle izmene Redeploy bez cache.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SEO: potvrđeni glavni domen. Ne koristiti localhost ili preview URL.
# Opciono: podrazumevano https://smrckopotrcko.rs. Posle izmene potreban novi build.
SITE_URL=https://smrckopotrcko.rs
# Opciono: samo content vrednost verifikacionog meta taga, ne ceo HTML tag.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Service role: full access to the database. Server only. Never NEXT_PUBLIC_.
# Needed to read telegram_chat_id and the assigned order after auto-dispatch.
SUPABASE_SERVICE_ROLE_KEY=

# Telegram bot (BotFather). Never NEXT_PUBLIC_ — anyone with the token can send as the bot.
TELEGRAM_BOT_TOKEN=

# Same string you pass to setWebhook secret_token. Telegram sends it as
# X-Telegram-Bot-Api-Secret-Token. Long random value.
TELEGRAM_WEBHOOK_SECRET=

# Bot username without @. Used to build https://t.me/IME_BOTA?start=ACCESS_TOKEN
TELEGRAM_BOT_USERNAME=

# Google Maps Platform key. Server only — never NEXT_PUBLIC_. Used by our
# /api/adrese route (Places Autocomplete) and delivery-price calc (Routes API).
# Restrict the key to "Routes API" + "Places API (New)" in Google Cloud Console.
GOOGLE_MAPS_API_KEY=

# Potpis Google predloga i ponude cene (15 minuta). Server only, nikad NEXT_PUBLIC_.
# Nasumičan ključ: najmanje 32 znaka. Postaviti i na Vercelu pre deploy-a ove faze.
ORDER_SIGNING_SECRET=

# Saradnja: Resend slanje mejlova. Sve tri vrednosti su samo za server.
RESEND_API_KEY=
# Opciono za test (podrazumevano onboarding@resend.dev). Za produkciju: verifikovan domen.
EMAIL_FROM=
# Za test sa resend.dev mora biti adresa kojom ste napravili Resend nalog.
PARTNERSHIP_EMAIL_TO=
